# Sarvam AI TTS (recommended for Tamil). Get key from https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_VOICE_ID_TA=vijay_ta_narration
SARVAM_VOICE_ID_EN=shubh

# ElevenLabs (alternative). Free tier: 10k credits/mo, non-commercial.
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID_TA=
ELEVEN_VOICE_ID_EN=

# TTS provider: sarvam | elevenlabs
TTS_PROVIDER=sarvam

# Whisper model size (tiny/base/small/medium/large). CPU: tiny recommended.
WHISPER_MODEL=tiny

# Python venv (for openai-whisper + yt-dlp)
PYTHON_VENV=.venv/bin/python

# Kilo LLM model for translation (use :free to avoid credit exhaustion)
KILO_MODEL=kilo/kilo-auto/free